# ==============================================================================
# DevProof Environment Variables Template
# Copy this to .env.local: cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Neon PostgreSQL Database (REQUIRED)
# ------------------------------------------------------------------------------
# Get from Neon Console -> Dashboard -> Connection Details
DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. Neon Auth / Better Auth (REQUIRED)
# ------------------------------------------------------------------------------
# Base URL from Neon Console -> Auth tab
NEON_AUTH_BASE_URL=https://[endpoint].neonauth.[region].aws.neon.tech/neondb/auth
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_here

# ------------------------------------------------------------------------------
# 4. Neon S3-Compatible Object Storage (REQUIRED for Avatars & Banners)
# ------------------------------------------------------------------------------
# Get from Neon Console -> Storage tab
NEON_STORAGE_ENDPOINT=https://[branch-id].storage.c-1.[region].aws.neon.tech
NEON_STORAGE_REGION=us-east-2
NEON_STORAGE_BUCKET=uploads
NEON_STORAGE_ACCESS_KEY_ID=your_storage_access_key_id
NEON_STORAGE_SECRET_ACCESS_KEY=your_storage_secret_access_key

# ------------------------------------------------------------------------------
# 5. GitHub API Token (REQUIRED for Heatmap & Commit Stats)
# ------------------------------------------------------------------------------
# Personal Access Token from: https://github.com/settings/tokens (classic)
# Scopes: public_repo, read:user
GITHUB_TOKEN=ghp_your_github_personal_access_token
